# Custom Suricata Rules — suricata-soc-platform
# These supplement the ET (Emerging Threats) open rule set.

# 1. Aggressive SSH brute force detection
alert tcp any any -> any 22 (msg:"SOC - Multiple SSH connections possible brute force"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;))

# 2. Outbound connection to known malicious / raw IP on uncommon port (possible C2 beacon)
alert tcp $HOME_NET any -> $EXTERNAL_NET !80,443,8080 (msg:"SOC - Suspicious outbound connection on non-standard port"; flow:to_server; flags:S; threshold:type limit, track by_src, count 3, seconds 300; classtype:bad-unknown; sid:1000002; rev:1;)

# 3. ICMP large packet / ping flood detection
alert icmp any any -> $HOME_NET any (msg:"SOC - ICMP flood detected"; dsize:>1400; threshold:type both, track by_src, count 10, seconds 10; classtype:bad-unknown; sid:1000003; rev:1;)

# 4. DNS query to suspicious TLDs
alert dns $HOME_NET any -> any any (msg:"SOC - DNS query to suspicious TLD (.xyz .top .tk)"; dns_query; content:".xyz"; nocase; classtype:bad-unknown; sid:1000004; rev:1;)
alert dns $HOME_NET any -> any any (msg:"SOC - DNS query to suspicious TLD (.top)"; dns_query; content:".top"; nocase; classtype:bad-unknown; sid:1000005; rev:1;)
alert dns $HOME_NET any -> any any (msg:"SOC - DNS query to suspicious TLD (.tk)"; dns_query; content:".tk"; nocase; classtype:bad-unknown; sid:1000006; rev:1;)

# 5. HTTP request to known malware pattern
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC - Possible malware download .exe from external"; flow:to_server; content:".exe"; http_uri; nocase; classtype:trojan-activity; sid:1000007; rev:1;)
